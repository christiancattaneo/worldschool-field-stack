# Copy this file to .env.local (which is gitignored) and fill in real values.
# NEVER commit real keys. The Field Stack apps read .env.local at runtime.

# Anthropic Claude API key. Used by the tutor (online mode), research assistant,
# and lesson generator. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Default is claude-opus-4-8 (latest, most capable).
# For cheaper, chat-heavy use set: claude-sonnet-4-6
CLAUDE_MODEL=

# Optional local model for the village tutor (fully offline). See
# field-stack/apps/village-tutor/LOCAL_MODEL.md
OLLAMA_MODEL=
OLLAMA_URL=
